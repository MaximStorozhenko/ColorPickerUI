<Window x:Class="DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ColorPickerUI.Controls;assembly=ColorPickerUI"
        xmlns:local="clr-namespace:DemoApp"
        mc:Ignorable="d"
        Title="ColorPicker Demo" Width="650"
        MinWidth="650" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#FF18191C">

    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalAlignment="Center">

            <controls:ColorPicker
                SelectedColor="{Binding SelectedColor, Mode=TwoWay}"
                ShowPresetColors="Visible" Palette="Pastel"
                PresetColorShape="Circle" PresetColorSize="Normal">
                <controls:ColorPicker.PresetCustomColors>
                    <Color>#FFF59E0B</Color>
                    <Color>#FFFF0000</Color>
                </controls:ColorPicker.PresetCustomColors>
            </controls:ColorPicker>

        </ScrollViewer>

        <StackPanel Grid.Column="1"
                    Margin="28,0,0,0"
                    VerticalAlignment="Center">

            <TextBlock Text="Selected color"
                       Foreground="#FFE8EAED"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock Text="The value updates automatically"
                       Foreground="#FF9AA0A6"
                       FontSize="13"
                       Margin="0,8,0,24"/>


            <StackPanel Orientation="Horizontal">
                <Button Tag="#F44336"
                        Background="#FFF44336"
                        Height="30" Width="30" Margin="5"
                        Command="{Binding SetColorCommand}"
                        CommandParameter="#F44336"
                        ToolTip="#F44336"/>

                <Button Tag="#FF9800"
                        Background="#FFFF9800"
                        Height="30" Width="30" Margin="5"
                        Command="{Binding SetColorCommand}"
                        CommandParameter="#FF9800"
                        ToolTip="#FF9800"/>
            </StackPanel>

            <Border 
                    BorderBrush="#FF3C4043"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Border.Background>
                    <SolidColorBrush Color="{Binding SelectedColor}"/>
                </Border.Background>

                <StackPanel>
                    <TextBlock Text="HEX VALUE"
                               Foreground="#FF9AA0A6"
                               FontSize="11"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding SelectedColorHex}"
                               Foreground="#FFE8EAED"
                               FontSize="22"
                               FontFamily="Consolas"/>

                    <TextBlock Text="SelectedColor"
                               Foreground="#FF9AA0A6"
                               FontSize="11"
                               Margin="0,20,0,8"/>

                    <TextBlock Text="{Binding SelectedColor}"
                               Foreground="#FFE8EAED"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Try selecting a preset or entering a HEX value."
                       Foreground="#FF9AA0A6"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0"/>

        </StackPanel>
    </Grid>
</Window>

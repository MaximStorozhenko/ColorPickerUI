<UserControl x:Class="ColorPicker.Wpf.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ColorPicker.Wpf.Controls"
             mc:Ignorable="d"
             MinWidth="280"
             d:DesignHeight="450" d:DesignWidth="280">
    
    <Border Background="#FF202124" BorderBrush="#FF3C4043"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel>
            <TextBlock Text="COLOR PICKER" Foreground="#FFE8EAED" FontSize="15" FontWeight="SemiBold" Margin="0 0 0 14"/>

            <!--Preview of the selected color-->
            <Border x:Name="PreviewBorder" Height="64" CornerRadius="8"
                    Background="#FF3B82F6" BorderBrush="#FF5F6368" BorderThickness="1"/>
            
            <!--HEX-->
            <TextBlock Text="HEX" Foreground="#FFBDC1C6"
                       Margin="0,16,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="HexTextBox"
                         Grid.Column="0"
                         Height="36"
                         Padding="9,0"
                         VerticalContentAlignment="Center"
                         Background="#FF303134"
                         Foreground="#FFE8EAED"
                         BorderBrush="#FF5F6368"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         Text="#3B82F6"
                         KeyDown="HexTextBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Apply"
                        Margin="8,0,0,0"
                        Padding="14,0"
                        Height="36"
                        Background="#FF3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ApplyHexButton_Click"/>

            </Grid>

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="#FFFF6B6B"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Visibility="Collapsed"
                       Text="Invalid HEX color"/>

            <!-- Preset colors -->
            <StackPanel Visibility="{Binding ShowPresetColors,
                RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}">
                <TextBlock Text="PRESET COLORS"
                           Foreground="#FFBDC1C6"
                           Margin="0,18,0,10"/>

                <UniformGrid Columns="6" Rows="2" HorizontalAlignment="Center">

                    <Button Tag="#F44336"
                            Background="#FFF44336"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#F44336"/>

                    <Button Tag="#FF9800"
                            Background="#FFFF9800"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#FF9800"/>

                    <Button Tag="#FFEB3B"
                            Background="#FFFFEB3B"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#FFEB3B"/>

                    <Button Tag="#4CAF50"
                            Background="#FF4CAF50"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#4CAF50"/>

                    <Button Tag="#00BCD4"
                            Background="#FF00BCD4"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#00BCD4"/>

                    <Button Tag="#2196F3"
                            Background="#FF2196F3"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#2196F3"/>

                    <Button Tag="#3F51B5"
                            Background="#FF3F51B5"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#3F51B5"/>

                    <Button Tag="#9C27B0"
                            Background="#FF9C27B0"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#9C27B0"/>

                    <Button Tag="#E91E63"
                            Background="#FFE91E63"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#E91E63"/>

                    <Button Tag="#FFFFFF"
                            Background="#FFFFFFFF"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#FFFFFF"/>

                    <Button Tag="#9E9E9E"
                            Background="#FF9E9E9E"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#9E9E9E"/>

                    <Button Tag="#212121"
                            Background="#FF212121"
                            Height="30" Width="30" Margin="5"
                            Click="PresetColorButton_Click"
                            ToolTip="#212121"/>

                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

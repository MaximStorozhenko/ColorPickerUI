<UserControl x:Class="ColorPickerUI.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ColorPickerUI.Controls"
             xmlns:converters="clr-namespace:ColorPickerUI.Converters"
             mc:Ignorable="d"
             MinWidth="262" d:DesignWidth="310">

    <UserControl.Resources>
        <converters:SliderValuePositionConverter x:Key="SliderValuePositionConverter"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <DrawingBrush x:Key="CheckerboardBrush"
                      TileMode="Tile"
                      Viewport="0 0 16 16" ViewportUnits="Absolute"
                      Viewbox="0 0 16 16" ViewboxUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0 0 16 16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#FFCCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0 0 8 8"/>
                                <RectangleGeometry Rect="8 8 8 8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ColorSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#FF9A9A9B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">

                            <!--Colored path-->
                            <Border Height="8" CornerRadius="4" Background="{TemplateBinding Background}"/>

                            <!--Thumb-->
                            <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Background="#FF0067C0" BorderBrush="#FF454545" BorderThickness="3">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid>
                                                    <Ellipse x:Name="FocusRing" Stroke="#80454545" StrokeThickness="2"
                                                     Fill="Transparent" Margin="0"/>

                                                    <Ellipse x:Name="ThumbCircle" Width="18" Height="18" Fill="{TemplateBinding Background}"
                                                     StrokeThickness="3" Stroke="{TemplateBinding BorderBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Fill" Value="#71ADDC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Background="#FF202124" BorderBrush="#FF3C4043"
            BorderThickness="1" CornerRadius="10" Padding="10">
        <StackPanel>
            <!--<TextBlock Text="COLOR PICKER" Foreground="#FFE8EAED" FontSize="15" FontWeight="SemiBold" Margin="0 0 0 10"/>-->

            <!--Preview of the selected color-->
            <Border Height="50" CornerRadius="8" Margin="0 0 0 10"
                    Visibility="{Binding ShowPreviewSelectedColor, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}"
                    BorderBrush="#FF5F6368" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- Chess background -->
                    <Border Background="{StaticResource CheckerboardBrush}" CornerRadius="7.5"/>

                    <!-- Selected color -->
                    <Border x:Name="PreviewBorder" Background="Red"  CornerRadius="7.5"/>
                </Grid>
            </Border>

            <!-- HSV Palette -->
            <Grid>
                <Canvas x:Name="SvCanvas" Height="140" ClipToBounds="True" Background="Red"
                        MouseLeftButtonDown="SvCanvas_MouseLeftButtonDown"
                        MouseMove="SvCanvas_MouseMove"
                        MouseLeftButtonUp="SvCanvas_MouseLeftButtonUp"
                        SizeChanged="SvCanvas_SizeChanged"
                        LostMouseCapture="SvCanvas_LostMouseCapture">

                    <!-- White gradient: saturation -->
                    <Rectangle IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=SvCanvas}"
                               Height="{Binding ActualHeight, ElementName=SvCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Black gradient: value -->
                    <Rectangle IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=SvCanvas}"
                               Height="{Binding ActualHeight, ElementName=SvCanvas}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Selection marker -->
                    <Ellipse x:Name="SvMarker"
                             Width="14" Height="14"
                             Stroke="White" StrokeThickness="2" Fill="Transparent"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>

                </Canvas>
            </Grid>

            <!--Color model tabs-->
            <TabControl Margin="0 10 0 0" Background="Transparent" BorderThickness="0">

                <TabControl.Resources>
                    <!--Style buttons-->
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Foreground" Value="#FFBDC1C6"/>
                        <Setter Property="Background" Value="#FF303134"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12 8"/>
                        <Setter Property="Margin" Value="2 0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Border x:Name="TabBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="8" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Stretch"                                                          
                                                          VerticalAlignment="Center"
                                                          TextBlock.TextAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder"
                                                    Property="Background" Value="#FF3B82F6"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder"
                                                    Property="Opacity" Value="0.85"/>
                                        </Trigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
                
                <!-- Убираем стандартную рамку и нижнюю полосу -->
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <ItemsPresenter/>
                            </StackPanel>

                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0 5 0 0"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!--HSV TAB-->
                <TabItem Header="HSV">
                    <StackPanel Background="Transparent">

                        <TextBlock Text="Hue" Foreground="#FFBDC1C6"/>

                        <Grid>
                            <Slider x:Name="HueSlider" Minimum="0" Maximum="359"
                                    ValueChanged="HsvSlider_ValueChanged" Margin="0 18 0 0"
                                    Style="{StaticResource ColorSliderStyle}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="1 0">
                                        <GradientStop Color="Red" Offset="0"/>
                                        <GradientStop Color="Yellow" Offset="0.167"/>
                                        <GradientStop Color="Lime" Offset="0.333"/>
                                        <GradientStop Color="Cyan" Offset="0.5"/>
                                        <GradientStop Color="Blue" Offset="0.667"/>
                                        <GradientStop Color="Magenta" Offset="0.833"/>
                                        <GradientStop Color="Red" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <Canvas IsHitTestVisible="False">
                                <Border Width="35" Height="18" CornerRadius="4"
                                        Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">

                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                            <Binding ElementName="HueSlider" Path="Value"/>
                                            <Binding ElementName="HueSlider" Path="Minimum"/>
                                            <Binding ElementName="HueSlider" Path="Maximum"/>
                                            <Binding ElementName="HueSlider" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>

                                    <TextBlock Text="{Binding ElementName=HueSlider, Path=Value, StringFormat={}{0:F0}}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="Saturation" Foreground="#FFBDC1C6"/>

                        <Grid>
                            <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100"
                                    Margin="0 18 0 0" ValueChanged="HsvSlider_ValueChanged"
                                    Style="{StaticResource ColorSliderStyle}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="1 0">
                                        <GradientStop Color="#FF808080" Offset="0"/>
                                        <GradientStop Color="#FF3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <Canvas IsHitTestVisible="False">
                                <Border Width="35" Height="18" CornerRadius="4"
                                        Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">

                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                            <Binding ElementName="SaturationSlider" Path="Value"/>
                                            <Binding ElementName="SaturationSlider" Path="Minimum"/>
                                            <Binding ElementName="SaturationSlider" Path="Maximum"/>
                                            <Binding ElementName="SaturationSlider" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>

                                    <TextBlock Text="{Binding ElementName=SaturationSlider, Path=Value, StringFormat={}{0:F0}}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                            
                        </Grid>

                        <TextBlock Text="Value" Foreground="#FFBDC1C6"/>

                        <Grid>
                            <Slider x:Name="ValueSlider" Minimum="0" Maximum="100"
                                    Margin="0 18 0 0" ValueChanged="HsvSlider_ValueChanged"
                                    Style="{StaticResource ColorSliderStyle}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="1 0">
                                        <GradientStop Color="Black" Offset="0"/>
                                        <GradientStop Color="#FF3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <Canvas IsHitTestVisible="False">
                                <Border Width="35" Height="18" CornerRadius="4"
                                        Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                            <Binding ElementName="ValueSlider" Path="Value"/>
                                            <Binding ElementName="ValueSlider" Path="Minimum"/>
                                            <Binding ElementName="ValueSlider" Path="Maximum"/>
                                            <Binding ElementName="ValueSlider" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>

                                    <TextBlock Text="{Binding ElementName=ValueSlider, Path=Value, StringFormat={}{0:F0}}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>

                    </StackPanel>
                </TabItem>

                <!--RGB TAB-->
                <TabItem Header="RGB">
                    <StackPanel Background="Transparent">

                        <TextBlock Text="Red"  Foreground="#FFBDC1C6"/>

                        <Grid>
                            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Height="22"
                                    Margin="0 18 0 0" ValueChanged="RgbSlider_ValueChanged"
                                    Style="{StaticResource ColorSliderStyle}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="1 0">
                                        <GradientStop Color="#FF303134" Offset="0"/>
                                        <GradientStop Color="#FFFF0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>

                            </Slider>

                            <Canvas IsHitTestVisible="False">
                                <Border Width="35" Height="18" CornerRadius="4"
                                        Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                            <Binding ElementName="RedSlider" Path="Value"/>
                                            <Binding ElementName="RedSlider" Path="Minimum"/>
                                            <Binding ElementName="RedSlider" Path="Maximum"/>
                                            <Binding ElementName="RedSlider" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>

                                    <TextBlock Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:F0}}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="Green" Foreground="#FFBDC1C6"/>

                        <Grid>
                            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255"
                                    Margin="0 18 0 0" ValueChanged="RgbSlider_ValueChanged"
                                    Style="{StaticResource ColorSliderStyle}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="1 0">
                                        <GradientStop Color="#FF303134" Offset="0"/>
                                        <GradientStop Color="#FF00FF00" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <Canvas IsHitTestVisible="False">
                                <Border Width="35" Height="18" CornerRadius="4"
                                        Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                            <Binding ElementName="GreenSlider" Path="Value"/>
                                            <Binding ElementName="GreenSlider" Path="Minimum"/>
                                            <Binding ElementName="GreenSlider" Path="Maximum"/>
                                            <Binding ElementName="GreenSlider" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>

                                    <TextBlock Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:F0}}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="Blue" Foreground="#FFBDC1C6"/>

                        <Grid>
                            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255"
                                    Margin="0 18 0 0" ValueChanged="RgbSlider_ValueChanged"
                                    Style="{StaticResource ColorSliderStyle}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0 0" EndPoint="1 0">
                                        <GradientStop Color="#FF303134" Offset="0"/>
                                        <GradientStop Color="#FF0000FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <Canvas IsHitTestVisible="False">
                                <Border Width="35" Height="18" CornerRadius="4"
                                        Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                            <Binding ElementName="BlueSlider" Path="Value"/>
                                            <Binding ElementName="BlueSlider" Path="Minimum"/>
                                            <Binding ElementName="BlueSlider" Path="Maximum"/>
                                            <Binding ElementName="BlueSlider" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Canvas.Left>

                                    <TextBlock Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:F0}}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Grid>

                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- Common Alpha slider -->
            <StackPanel Margin="0 5 0 0">
                <TextBlock Text="Alpha" Foreground="#FFBDC1C6"/>

                <Grid>
                    <Grid>
                        <Border Height="8" VerticalAlignment="Center" CornerRadius="4" Margin="0 18 0 0" 
                                Background="{StaticResource CheckerboardBrush}"/>
                        <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255"
                                Margin="0 18 0 0" ValueChanged="AlphaSlider_ValueChanged"
                                Style="{StaticResource ColorSliderStyle}">
                            <Slider.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#003B82F6" Offset="0"/>
                                    <GradientStop Color="#FF3B82F6" Offset="1"/>
                                </LinearGradientBrush>
                            </Slider.Background>
                        </Slider>
                    </Grid>
                    
                    <Canvas IsHitTestVisible="False">
                        <Border Width="35" Height="18" CornerRadius="4"
                                Background="#FF303134" BorderBrush="#FF5F6368" BorderThickness="1">
                            <Canvas.Left>
                                <MultiBinding Converter="{StaticResource SliderValuePositionConverter}">
                                    <Binding ElementName="AlphaSlider" Path="Value"/>
                                    <Binding ElementName="AlphaSlider" Path="Minimum"/>
                                    <Binding ElementName="AlphaSlider" Path="Maximum"/>
                                    <Binding ElementName="AlphaSlider" Path="ActualWidth"/>
                                </MultiBinding>
                            </Canvas.Left>

                            <TextBlock Text="{Binding ElementName=AlphaSlider, Path=Value, StringFormat={}{0:F0}}"
                                       Foreground="White" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Canvas>
                </Grid>
            </StackPanel>

            <!--HEX-->
            <TextBlock Text="HEX" Foreground="#FFBDC1C6" Margin="0 5"/>

            <Grid Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="HexTextBox" Height="35" Padding="9 0"
                             VerticalContentAlignment="Center"
                             Background="#FF303134" Foreground="#FFE8EAED"
                             BorderBrush="#FF5F6368" BorderThickness="1"
                             FontFamily="Consolas"
                             KeyDown="HexTextBox_KeyDown"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0 0 5 0">

                        <!--Button for the copies the currently selected color-->
                        <Button Height="25" Width="25" Padding="0"
                                Background="Transparent" Foreground="#FFBDC1C6"
                                BorderThickness="0" Cursor="Hand"
                                Click="CopyColorButton_Click">

                            <Viewbox Width="23" Height="23" Stretch="Uniform">
                                <Canvas Width="48" Height="48">
                                    <Path Fill="#429CE3"
                                          Data="M17 16.5h-4.75a3.75 3.75 0 0 0-3.75 3.75v15.5a3.75 3.75 0 0 0 3.75 3.75h10.5a3.75 3.75 0 0 0 3.741-3.5h2.503a6.25 6.25 0 0 1-6.244 6h-10.5A6.25 6.25 0 0 1 6 35.75v-15.5A6.25 6.25 0 0 1 12.25 14H17zM35.75 6A6.25 6.25 0 0 1 42 12.25v15.5A6.25 6.25 0 0 1 35.75 34h-10.5A6.25 6.25 0 0 1 19 27.75v-15.5A6.25 6.25 0 0 1 25.25 6zm-10.5 2.5a3.75 3.75 0 0 0-3.75 3.75v15.5a3.75 3.75 0 0 0 3.75 3.75h10.5a3.75 3.75 0 0 0 3.75-3.75v-15.5a3.75 3.75 0 0 0-3.75-3.75z"/>
                                </Canvas>
                            </Viewbox>

                        </Button>

                        <!--Button for the updates the selected color copy format-->
                        <Button Height="25" Width="25" Padding="0"
                                Background="Transparent" Foreground="#FFBDC1C6"
                                BorderThickness="0" Cursor="Hand"
                                Click="CopyFormatButton_Click">

                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="HEX" Tag="HEX"
                                              Click="CopyFormatMenuItem_Click"/>
                                    <MenuItem Header="RGB" Tag="RGB"
                                              Click="CopyFormatMenuItem_Click"/>
                                    <MenuItem Header="ARGB" Tag="ARGB"
                                              Click="CopyFormatMenuItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            
                            <Viewbox Width="10" Height="10" Stretch="Uniform">
                                <Canvas Width="48" Height="48">
                                    <Path Fill="#429CE3"
                                          Data="M27.528 40.772c-1.617 2.99-5.915 2.966-7.499-.041L4.495 11.229C3.005 8.4 5.057 5 8.255 5h31.488c3.22 0 5.27 3.44 3.739 6.272z"/>
                                </Canvas>
                            </Viewbox>
                            
                        </Button>
                    </StackPanel>
                </Grid>

                <Button Grid.Column="1" Content="Apply"
                        Margin="8 0 0 0" Padding="14 0"
                        Height="35"
                        Background="#FF3B82F6" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="ApplyHexButton_Click"/>
            </Grid>

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="#FFFF6B6B"
                       FontSize="12"
                       Margin="0 5"
                       Visibility="Collapsed"
                       Text="Invalid HEX color"/>

            <!-- Preset colors -->
            <StackPanel Visibility="{Binding ShowPresetColors, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}">

                <TextBlock Text="PRESET COLORS"
                           Foreground="#FFBDC1C6"
                           Margin="0 5 0 0"/>

                <ItemsControl ItemsSource="{Binding DisplayedPresetColors, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="5"
                                    Background="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                    BorderThickness="1" BorderBrush="#FF5F6368"
                                    Tag="{Binding}"
                                    Cursor="Hand" Click="PresetColorButton_Click">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Width" Value="26"/>
                                        <Setter Property="Height" Value="26"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PresetColorSize,
                                                RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}"
                                                         Value="Small">
                                                <Setter Property="Width" Value="20"/>
                                                <Setter Property="Height" Value="20"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding PresetColorSize,
                                                RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}"
                                                         Value="Large">
                                                <Setter Property="Width" Value="32"/>
                                                <Setter Property="Height" Value="32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ColorBorder"
                                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0"/>
                                            </Border.Effect>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <DataTrigger Binding="{Binding PresetColorShape, RelativeSource={RelativeSource AncestorType={x:Type local:ColorPicker}}}"
                                                         Value="Circle">
                                                <Setter TargetName="ColorBorder" Property="CornerRadius" Value="50"/>
                                            </DataTrigger>
                                            
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ColorBorder" Property="BorderBrush" Value="White"/>
                                                <Setter TargetName="ColorBorder" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ColorBorder" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                            
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ColorBorder" Property="Opacity" Value="0.4"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>